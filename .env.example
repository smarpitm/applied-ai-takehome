# =============================================================================
# Applied AI / ML Engineering Take-Home — Environment Configuration Template
# Copy to .env and fill in your API keys locally. Never commit .env!
# Routing is API-first with automatic fallback to local Ollama if keys are
# unset, rate-limited, or unreachable.
# =============================================================================

# --- Cloud API Keys (API-first routing; leave blank to test local fallback) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local Ollama Fallback Configuration ---
ENABLE_LOCAL_FALLBACK=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_P1_FALLBACK_MODEL=llama3.1:latest
OLLAMA_P2_GENERATOR_FALLBACK_MODEL=llama3.1:latest
OLLAMA_P2_JUDGE_FALLBACK_MODEL=qwen2.5:3b

# --- Problem 1: Cost-Efficient RAG ---
P1_VECTOR_STORE=lancedb
LANCEDB_PATH=./data/lancedb
LANCEDB_TABLE=rag_chunks

# Optional Qdrant bonus store (Docker memmap+int8 or local disk fallback)
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=rag_chunks

# Local 384-dim embeddings (4x storage/I/O savings vs 1536-dim)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Ingestion & recursive token chunking defaults
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# Retrieval & zero-LLM refusal guardrail (calibrated for bge-small-en-v1.5)
TOP_K=5
MIN_SIMILARITY_SCORE=0.665

# Problem 1 Generator & Separate Eval Judge (API-first -> local Ollama fallback)
P1_LLM_PROVIDER=groq
P1_LLM_MODEL=llama-3.1-8b-instant
P1_LLM_TEMPERATURE=0.1
P1_JUDGE_PROVIDER=gemini
P1_JUDGE_MODEL=gemini-2.5-flash

# --- Problem 2: LLM-as-Judge Pipeline ---
# Generator and Judge must remain independently configurable (distinct families)
P2_GENERATOR_PROVIDER=groq
P2_GENERATOR_MODEL=llama-3.3-70b-versatile
P2_GENERATOR_TEMPERATURE=0.2
P2_JUDGE_PROVIDER=gemini
P2_JUDGE_MODEL=gemini-2.5-flash
P2_JUDGE_TEMPERATURE=0.0
P2_PASS_THRESHOLD=3.5

# --- Telemetry & Audit Logs ---
LOG_DIR=./results/logs
LOG_LEVEL=INFO
